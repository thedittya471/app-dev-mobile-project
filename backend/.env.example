# Express server port
PORT=3000

# Published Postgres port on loopback (default 5433 to avoid conflict with local postgres)
DB_PORT=5433

# Postgres connection URL (bound to loopback in docker-compose)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/attendance_pilot

# Allowed browser origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
